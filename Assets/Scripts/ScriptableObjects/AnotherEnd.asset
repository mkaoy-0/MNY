%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 97c9ae89183ca9940bb0f0a275c4e8a5, type: 3}
  m_Name: AnotherEnd
  m_EditorClassIdentifier: Assembly-CSharp::EndingData
  endingName: anotherEnd
  dialogues:
  - speaker: 2
    text: "X\u65E5\u5F8C\u2026\u2026"
    face:
      eye: {fileID: 0}
      mouth: {fileID: 0}
      deco: {fileID: 0}
    isEnter: 1
    isExit: 0
  - speaker: 1
    text: "\uFF08\u2026\u2026\u2026\u306A\u3093\u3067\u3053\u3046\u306A\u3063\u305F\u3093\u3060\u3063\u3051\uFF1F\uFF09"
    face:
      eye: {fileID: -8841383410735724184, guid: b071d3371f75dd74a91cf0b1985fa823, type: 3}
      mouth: {fileID: 0}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\uFF08\u3042\u3041\u3001\u305D\u3046\u3060\u3002\u524D\u306B\u304A\u59EB\u69D8\u3092\u751F\u3051\u6355\u308A\u306B\u3057\u308D\u3063\u3066\u8A00\u3063\u305F\u3093\u3060\u3063\u3051\u2026\u2026\uFF09"
    face:
      eye: {fileID: -8683673992280644859, guid: 278cd8087a9f88743b291cd8fc6238e9, type: 3}
      mouth: {fileID: 0}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\uFF08\u307E\u3055\u304B\u672C\u5F53\u306B\u9023\u308C\u3066\u304F\u308B\u3068\u306F\u601D\u3063\u3066\u306A\u304B\u3063\u305F\u3088\u2026\u2026\uFF01\uFF09"
    face:
      eye: {fileID: -8683673992280644859, guid: 278cd8087a9f88743b291cd8fc6238e9, type: 3}
      mouth: {fileID: 2769991944876818550, guid: e833c09e33c51914bb387574ebb8b122, type: 3}
      deco: {fileID: 1885003711856960554, guid: d832664df4a81044c8c0f4111bde35f4, type: 3}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\uFF08\u3069\u3046\u3057\u3088\u3046\u3001\u3053\u306E\u72B6\u6CC1\uFF5E\uFF5E\uFF01\uFF01\uFF09"
    face:
      eye: {fileID: 2640839267372648919, guid: 0e16c534f94e99244a16e5520451008e, type: 3}
      mouth: {fileID: 2769991944876818550, guid: e833c09e33c51914bb387574ebb8b122, type: 3}
      deco: {fileID: 1885003711856960554, guid: d832664df4a81044c8c0f4111bde35f4, type: 3}
    isEnter: 0
    isExit: 0
  - speaker: 0
    text: "\u2026\u2026\u2026\u8CB4\u65B9\u304C\u9B54\u738B\u3001\u30B6\u30CF\u30C8\u30FB\u30D5\u30ED\u30C3\u30AF\u30B9\uFF1F"
    face:
      eye: {fileID: 0}
      mouth: {fileID: -7197281574937372023, guid: 5921f8cb2902a3b44bbe28a450c3516e, type: 3}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\u2026\u2026\uFF01\u2026\u2026\u3042\u3042\u3001\u305D\u3046\u3060\u3002\u30D0\u30EC\u30A4\u30B7\u30A2\u306E\u7B2C\u4E00\u738B\u5973\u3001\u30D5\u30A3\u30FC\u30EA\u30A2\u30FB\u30A2\u30EB\u30B9\u30C8\u30E0\u30FB\u30D0\u30EC\u30A4\u30B7\u30A2"
    face:
      eye: {fileID: 3352256765388004796, guid: 5c5f9b58ee96f084d8b7cfde1426fcbd, type: 3}
      mouth: {fileID: -8095202797473960377, guid: ecb25d93912396b4ab1b1206aedc17cd, type: 3}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 0
  - speaker: 2
    text: "\u2026\u2026\u6B53\u8FCE\u3057\u3088\u3046\u3002\u3088\u3046\u3053\u305D\u6211\u304C\u57CE\u3078"
    face:
      eye: {fileID: -8683673992280644859, guid: 278cd8087a9f88743b291cd8fc6238e9, type: 3}
      mouth: {fileID: -7519909638647247912, guid: 542de5c8a7dbd7c418f857e5358bb134, type: 3}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 1
  - speaker: 2
    text: "\u3053\u306E\u59EB\u3068\u306E\u51FA\u4F1A\u3044\u304C\u3001\u9B54\u738B\u306E\u904B\u547D\u3092\u5927\u304D\u304F\u5909\u3048\u308B\u3053\u3068\u306B\u306A\u308B"
    face:
      eye: {fileID: 0}
      mouth: {fileID: 0}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 0
  - speaker: 2
    text: "\u2026\u2026\u304C\u3001\u305D\u308C\u306F\u307E\u305F\u5225\u306E\u304A\u8A71\u3002"
    face:
      eye: {fileID: 0}
      mouth: {fileID: 0}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 0
