      text: "\u2026\u2026\u5909\u306A\u3053\u3068\u3092\u805E\u3044\u3066\u3057\u307E\u3044\u307E\u3057\u305F\u306D\u3002\u7533\u3057\u8A33\u3042\u308A\u307E\u305B\u3093\u3067\u3057\u305F"
