    - speaker: 0
      text: "\u5FC3\u914D\u306A\u3055\u3089\u305A\u3068\u3082\u4EBA\u9593\u3069\u3082\u306F\u5FC5\u305A\u6EC5\u307C\u3057\u3001\u9B54\u738B\u69D8\u306B\u52DD\u5229\u3092\u304A\u7D04\u675F\u3044\u305F\u3057\u307E\u3059"
