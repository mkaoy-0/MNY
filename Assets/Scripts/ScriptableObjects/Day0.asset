  missReaction: "\u9B54\u738B\u69D8\u3001\u5927\u4E08\u592B\u3067\u3059\u304B\uFF1F"
  timeLimitReaction: "\u306A\u305C\u9ED9\u3063\u3066\u3044\u3089\u3063\u3057\u3083\u308B\u306E\u3067\u3059\u304B\uFF1F"
  introMessages:
  - speaker: 0
    text: "\u2026\u2026\u5831\u544A\u306F\u4EE5\u4E0A\u3067\u3059"
    face:
      eye: {fileID: 5545752619652986929, guid: af2d19b17d1426241ac811e5dd0100d5, type: 3}
      mouth: {fileID: 39662851386448069, guid: 1199930ccf4b475489b984cf4012310f, type: 3}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\u3042\u3042\u3001\u3054\u82E6\u52B4\u3060\u3063\u305F\u3002\u3053\u306E\u8ABF\u5B50\u3067\u4EBA\u9593\u3069\u3082\u3092\u6839\u7D76\u3084\u3057\u306B\u3057\u308D"
    face:
      eye: {fileID: 3352256765388004796, guid: 5c5f9b58ee96f084d8b7cfde1426fcbd, type: 3}
      mouth: {fileID: -7519909638647247912, guid: 542de5c8a7dbd7c418f857e5358bb134, type: 3}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 0
  - speaker: 0
    text: "\u6D41\u77F3\u306F\u9B54\u738B\u69D8\u3002\u8CB4\u65B9\u69D8\u3053\u305D\u8AB0\u3088\u308A\u6B8B\u9177\u3067\u6B8B\u5FCD\u3067\u3001\u9593\u9055\u3044\u306A\u304F\u6B74\u4EE3\u6700\u9AD8\u306E\u9B54\u738B\u3067\u3059"
    face:
      eye: {fileID: 5148122948628019522, guid: 880c294971f6a5f47ae61151abdb2eb7, type: 3}
      mouth: {fileID: -2616019531537676843, guid: 24706c26b34e92a4ba7897671d732787, type: 3}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 0
  - speaker: 0
    text: "\u627F\u77E5\u3044\u305F\u3057\u307E\u3057\u305F\u3002\u5168\u3066\u306F\u9B54\u738B\u69D8\u306E\u305F\u3081\u306B"
    face:
      eye: {fileID: 5545752619652986929, guid: af2d19b17d1426241ac811e5dd0100d5, type: 3}
      mouth: {fileID: -2616019531537676843, guid: 24706c26b34e92a4ba7897671d732787, type: 3}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 1
  - speaker: 1
    text: "\u2026\u2026"
    face:
      eye: {fileID: 3352256765388004796, guid: 5c5f9b58ee96f084d8b7cfde1426fcbd, type: 3}
      mouth: {fileID: 0}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\u2026\u2026\u3000\u2026\u2026\u3000\u2026\u2026"
    face:
      eye: {fileID: -8683673992280644859, guid: 278cd8087a9f88743b291cd8fc6238e9, type: 3}
      mouth: {fileID: 0}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\u2026\u2026\u884C\u3063\u305F\u304B"
    face:
      eye: {fileID: 3352256765388004796, guid: 5c5f9b58ee96f084d8b7cfde1426fcbd, type: 3}
      mouth: {fileID: -8095202797473960377, guid: ecb25d93912396b4ab1b1206aedc17cd, type: 3}
      deco: {fileID: 0}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "<size=1.3em>\u306F\u3042\uFF5E\uFF5E\uFF5E\u75B2\u308C\u305F\u3041\uFF5E\uFF5E\uFF5E\uFF01\uFF01"
    face:
      eye: {fileID: 2640839267372648919, guid: 0e16c534f94e99244a16e5520451008e, type: 3}
      mouth: {fileID: 3051296416116236655, guid: eb578a28658e48c41ac54b48359f7b87, type: 3}
      deco: {fileID: 1885003711856960554, guid: d832664df4a81044c8c0f4111bde35f4, type: 3}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\u3082\u3046\u7121\u7406\uFF01\u4F55\u3001\u6839\u7D76\u3084\u3057\u3063\u3066\uFF01\u7269\u9A12\uFF01\uFF01"
    face:
      eye: {fileID: 2640839267372648919, guid: 0e16c534f94e99244a16e5520451008e, type: 3}
      mouth: {fileID: 5035928993336525301, guid: 43cde478ef360b04abf104370c0b47ff, type: 3}
      deco: {fileID: 1885003711856960554, guid: d832664df4a81044c8c0f4111bde35f4, type: 3}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\u306A\u3093\u3067\u6226\u4E89\u306A\u3093\u304B\u3084\u3063\u3066\u308B\u306E\uFF01\uFF1F\u4E89\u3044\u306F\u4F55\u3082\u751F\u307E\u306A\u3044\u3058\u3083\u3093\uFF01\uFF01\u6226\u4E89\u53CD\u5BFE\uFF01\uFF01"
    face:
      eye: {fileID: 2640839267372648919, guid: 0e16c534f94e99244a16e5520451008e, type: 3}
      mouth: {fileID: 3051296416116236655, guid: eb578a28658e48c41ac54b48359f7b87, type: 3}
      deco: {fileID: 1885003711856960554, guid: d832664df4a81044c8c0f4111bde35f4, type: 3}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\u2026\u2026\u3063\u3066\u8A00\u3063\u3066\u3082\u3001\u3053\u3063\u3061\u304C\u548C\u89E3\u3092\u7533\u3057\u51FA\u305F\u3068\u3053\u308D\u3067\u4EBA\u9593\u5074\u304C\u53D7\u3051\u5165\u308C\u308B\u308F\u3051\u306A\u3044\u3057"
    face:
      eye: {fileID: -8841383410735724184, guid: b071d3371f75dd74a91cf0b1985fa823, type: 3}
      mouth: {fileID: 2769991944876818550, guid: e833c09e33c51914bb387574ebb8b122, type: 3}
      deco: {fileID: 1885003711856960554, guid: d832664df4a81044c8c0f4111bde35f4, type: 3}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\u305D\u3082\u305D\u3082\u3001\u3053\u3063\u3061\u306B\u3082\u4EBA\u9593\u3092\u6068\u3093\u3067\u308B\u5B50\u304C\u3044\u3063\u3071\u3044\u3044\u308B\u3057"
    face:
      eye: {fileID: 2640839267372648919, guid: 0e16c534f94e99244a16e5520451008e, type: 3}
      mouth: {fileID: 2769991944876818550, guid: e833c09e33c51914bb387574ebb8b122, type: 3}
      deco: {fileID: 1885003711856960554, guid: d832664df4a81044c8c0f4111bde35f4, type: 3}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\u548C\u89E3\u3057\u3088\u3046\u306A\u3093\u3066\u8A00\u304A\u3046\u3082\u3093\u306A\u3089\u3001\u66B4\u52D5\u304C\u8D77\u304D\u308B\u2026\u2026\uFF01"
    face:
      eye: {fileID: 2640839267372648919, guid: 0e16c534f94e99244a16e5520451008e, type: 3}
      mouth: {fileID: 3051296416116236655, guid: eb578a28658e48c41ac54b48359f7b87, type: 3}
      deco: {fileID: 1885003711856960554, guid: d832664df4a81044c8c0f4111bde35f4, type: 3}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\u88CF\u5207\u8005\u30FC\uFF01\u9B54\u65CF\u306E\u6065\u3055\u3089\u3057\u30FC\uFF01\u3063\u3066\u8A00\u308F\u308C\u3066\u3001\u6700\u60AA\u50D5\u304C\u307F\u3093\u306A\u306B\u6BBA\u3055\u308C\u308B\u2026\u2026\uFF01\uFF01"
    face:
      eye: {fileID: 2640839267372648919, guid: 0e16c534f94e99244a16e5520451008e, type: 3}
      mouth: {fileID: 5035928993336525301, guid: 43cde478ef360b04abf104370c0b47ff, type: 3}
      deco: {fileID: 1885003711856960554, guid: d832664df4a81044c8c0f4111bde35f4, type: 3}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\u307F\u3093\u306A\u306E\u524D\u3067\u306F\u7D76\u5BFE\u306B\u201D\u7406\u60F3\u306E\u9B54\u738B\u201D\u3067\u3044\u306A\u304D\u3083\u2026\u2026"
    face:
      eye: {fileID: -8841383410735724184, guid: b071d3371f75dd74a91cf0b1985fa823, type: 3}
      mouth: {fileID: 5035928993336525301, guid: 43cde478ef360b04abf104370c0b47ff, type: 3}
      deco: {fileID: 1885003711856960554, guid: d832664df4a81044c8c0f4111bde35f4, type: 3}
    isEnter: 0
    isExit: 0
  - speaker: 1
    text: "\u7D76\u5BFE\u306B\u3001\u4F55\u304C\u4F55\u3067\u3082\u3001\u88CF\u306E\u9854\u304C\u30D0\u30EC\u3061\u3083\u30C0\u30E1\u3060\u2026\u2026\uFF01\uFF01"
    face:
      eye: {fileID: 2640839267372648919, guid: 0e16c534f94e99244a16e5520451008e, type: 3}
